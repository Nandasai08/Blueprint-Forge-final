# Public Supabase settings used by the browser app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side Supabase settings. Store SUPABASE_SECRET_KEY in Replit Secrets,
# not in this file or in browser-exposed VITE_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=
